APP_NAME=Enterprise RAG
APP_VERSION=0.1.0
APP_ENV=production

# HTTPS 由 Nginx 终止；浏览器同域访问时通常不需要 CORS。
# 如需跨域管理后台，填写明确来源，逗号分隔，不建议使用 *。
CORS_ORIGINS=https://rag.example.com

# ===== Embedding / LLM =====
EMBEDDING_PROVIDER=aliyun
ALIYUN_API_KEY=replace-with-real-aliyun-api-key
ALIYUN_EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_CONCURRENCY=5

ANSWER_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-real-deepseek-api-key
DEEPSEEK_CHAT_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

JUDGE_ENABLED=false

# ===== Storage =====
CHROMA_DIR=/app/data/chroma
CHROMA_COLLECTION=knowledge_base
DOCUMENTS_DIR=/app/data/documents
DOCUMENT_UPLOAD_MAX_MB=50
FEEDBACK_ATTACHMENT_DIR=/app/data/feedback_attachments
FEEDBACK_ATTACHMENT_MAX_COUNT=5
FEEDBACK_ATTACHMENT_MAX_MB=5
LOG_DIR=/app/logs

# ===== Retrieval =====
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.5
RERANK_ENABLED=false
RERANK_PROVIDER=aliyun
ALIYUN_RERANK_MODEL=gte-rerank-v2
ALIYUN_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_STRATEGY=sort
RERANK_WINDOW_MULTIPLIER=2
RERANK_WEIGHT=0.6
MULTI_QUERY_ENABLED=false
MULTI_QUERY_COUNT=3
QUERY_REWRITE_PROVIDER=deepseek
RETRIEVAL_MODE=auto
RETRIEVAL_CONTEXT_WINDOW=0
RETRIEVAL_CONTEXT_MAX_CHARS=1200
HYBRID_BM25_TOP_K_MULTIPLIER=4
HYBRID_RRF_K=60

# ===== MySQL =====
# docker-compose 会把 MYSQL_HOST 覆盖为 mysql；这里保留给非 compose 场景参考。
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=rag_app
MYSQL_PASSWORD=change-this-app-password
MYSQL_DATABASE=enterprise_rag
MYSQL_ENABLED=true
MYSQL_ROOT_PASSWORD=change-this-root-password

# ===== Monitoring =====
MODEL_USAGE_ALERT_MIN_CALLS=5
MODEL_USAGE_ALERT_ERROR_RATE=0.2
MODEL_USAGE_ALERT_LATENCY_EMBEDDING_MS=10000
MODEL_USAGE_ALERT_LATENCY_CHAT_MS=20000
MODEL_USAGE_ALERT_LATENCY_RERANK_MS=8000
MODEL_USAGE_ALERT_TOKEN_DAILY=100000

# ===== Auth =====
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=720
DEFAULT_ADMIN_USERNAME=rag_admin
DEFAULT_ADMIN_PASSWORD=change-this-admin-password
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
