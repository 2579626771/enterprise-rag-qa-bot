# Local environment and secrets
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/

# Python cache and test cache
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local editor/tooling files
.vscode/
.idea/

# 前端构建产物 / TS 增量编译缓存（不进仓库）
frontend/*.tsbuildinfo
frontend/**/*.tsbuildinfo
frontend/dist/
frontend/node_modules/

# Logs and temporary files
*.log
logs/
.DS_Store
Thumbs.db

# 运行时数据：上传的文档与向量库，属于运行产生的数据，不进仓库。
# （避免 git 仓库被文档/向量库撑大；文件仍正常存在磁盘上，程序照常读写）
data/documents/
data/chroma/

# 运行时文档备份目录（迁移脚本产生，不进仓库）
data/documents.bak_*/

# 评测集与评测结果：含真实业务/内部文档信息，不进公开仓库（本地保留）。
# 仅放行脱敏示例与说明文档。
eval/*
!eval/README.md
!eval/qa_set.example.json
