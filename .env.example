APP_NAME=Enterprise RAG
APP_VERSION=0.1.0
APP_ENV=development

# ===== Embedding（向量化）=====
EMBEDDING_PROVIDER=aliyun
ALIYUN_API_KEY=your-aliyun-api-key
ALIYUN_EMBEDDING_MODEL=qwen3.7-text-embedding
# 向量化并发度：大文档分多批调用 embedding 接口，并发发送可显著加快入库。
# 默认 5；网络好可调大（如 8），遇到接口限流(429)可调小。
EMBEDDING_CONCURRENCY=5

# ===== 回答生成 =====
ANSWER_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_CHAT_MODEL=deepseek-v4-pro
# DeepSeek OpenAI 兼容基址（答案层「研判」用 LangChain ChatOpenAI 走此基址）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== 答案层「研判」防幻觉 =====
# JUDGE_ENABLED：作答时先让 LLM 判断「资料是否真能回答该问题」，不能答则明确拒答，
#   治「主题相关但库里没答案」导致的幻觉。默认 false（关闭时行为与引入前完全一致，可一键降级）。
JUDGE_ENABLED=false

# ===== 向量库（Chroma）与检索 =====
# CHROMA_DIR：向量库持久化目录（默认 data/chroma）
# CHROMA_COLLECTION：集合名（相当于知识库名，至少 3 个字符）
# RAG_TOP_K：每次提问检索的片段数（默认 5）
# RAG_MAX_DISTANCE：相似度距离阈值（余弦距离，越小越相关；大于此值视为不相关而丢弃，默认 0.5）
# DOCUMENTS_DIR：知识库文档目录（默认 data/documents）
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=knowledge_base
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.5
DOCUMENTS_DIR=data/documents

# ===== 问题反馈截图附件 =====
# FEEDBACK_ATTACHMENT_DIR：反馈截图本地存储目录；生产部署需纳入持久化卷或替换为对象存储。
# FEEDBACK_ATTACHMENT_MAX_COUNT：每条反馈最多截图张数。FEEDBACK_ATTACHMENT_MAX_MB：单张截图最大 MB。
FEEDBACK_ATTACHMENT_DIR=data/feedback_attachments
FEEDBACK_ATTACHMENT_MAX_COUNT=5
FEEDBACK_ATTACHMENT_MAX_MB=5

# ===== 检索增强：Rerank 重排（评测驱动，默认关）=====
# RERANK_ENABLED：召回后用 rerank 模型重排候选顺序（只重排、保留每条原距离，阈值/研判语义不变）。
#   默认 false——本库评测证明整体伤召回（Hit@5 94.7%→89.5%），代码/开关保留，可一键开再评。
# RERANK_PROVIDER：aliyun（真实 gte-rerank-v2）/ fake（确定性启发式，供单测零网络）。失败降级为原顺序。
RERANK_ENABLED=false
RERANK_PROVIDER=aliyun
ALIYUN_RERANK_MODEL=gte-rerank-v2
# ALIYUN_RERANK_URL：默认使用阿里云 DashScope gte-rerank-v2 text-rerank 端点；私有化/代理部署时可覆盖。
ALIYUN_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# RERANK_STRATEGY：sort=旧纯排序；window=只重排 top_k*N；weighted=向量距离+rerank分融合。
RERANK_STRATEGY=sort
RERANK_WINDOW_MULTIPLIER=2
RERANK_WEIGHT=0.6

# ===== 检索增强：多查询改写（评测驱动，默认关）=====
# MULTI_QUERY_ENABLED：把原问题改写成 N 条语义等价查询多路召回、去重保留最小距离（原查询始终保底）。
#   默认 false——评测正向（MRR 0.776→0.807、Hit@5 零误伤），但多一次 LLM 调用较慢(~2-8s)，按需手动开。
# MULTI_QUERY_COUNT：额外改写条数（默认 3）。QUERY_REWRITE_PROVIDER：deepseek（真实）/ fake（单测用）。失败降级只用原查询。
MULTI_QUERY_ENABLED=false
MULTI_QUERY_COUNT=3
QUERY_REWRITE_PROVIDER=deepseek

# ===== 检索模式/混合检索/邻近上下文（阶段6，默认兼容旧行为）=====
# RETRIEVAL_MODE：auto=兼容旧开关；vector=最稳降级；multi_query；rerank；rerank_fusion；hybrid；hybrid_rerank_fusion。
# 本轮评测：context_window=1 修复 #8/#55，Hit@5 94.7%→100%；hybrid 单独伤召回，默认不开。
RETRIEVAL_MODE=auto
# 邻近上下文扩展：只扩展最终 source 的 content，不改 distance/阈值语义。默认 0 关闭，质量优先可设 1。
RETRIEVAL_CONTEXT_WINDOW=0
RETRIEVAL_CONTEXT_MAX_CHARS=1200
# hybrid 模式：向量 + BM25(jieba) RRF 融合。
HYBRID_BM25_TOP_K_MULTIPLIER=4
HYBRID_RRF_K=60

# ===== MySQL（文档元数据持久化）=====
# 存放文档分类/描述/上传时间/状态等元数据，替换前端 localStorage。
# 库无需手动建表：后端启动会自动建 documents 表；库本身需先存在（utf8mb4）。
# MYSQL_ENABLED=false 可关闭 MySQL，后端自动降级为内存仓库（仅不落盘，主流程不受影响）。
# 后端会自动建/补用户、知识库、配额、文档元数据、会话、主题、检索配置、反馈、通知、模型用量等表。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=enterprise_rag
MYSQL_ENABLED=true

# ===== 模型用量监控告警阈值 =====
# 管理员“模型监控”页按调用记录实时计算告警；记录失败不会影响问答/入库主流程。
MODEL_USAGE_ALERT_MIN_CALLS=5
MODEL_USAGE_ALERT_ERROR_RATE=0.2
MODEL_USAGE_ALERT_LATENCY_EMBEDDING_MS=10000
MODEL_USAGE_ALERT_LATENCY_CHAT_MS=20000
MODEL_USAGE_ALERT_LATENCY_RERANK_MS=8000
MODEL_USAGE_ALERT_TOKEN_DAILY=100000

# ===== 认证（JWT）=====
# JWT_SECRET：登录令牌签名密钥，生产环境务必改成随机长字符串。
# JWT_EXPIRE_MINUTES：令牌有效期（分钟），默认 720=12 小时。
# DEFAULT_ADMIN_*：首次启动、用户表为空时自动创建的管理员账号。
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRE_MINUTES=720
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
# 连续登录失败保护：输错达到阈值后短时锁定；管理员重置密码会清除锁定。
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
