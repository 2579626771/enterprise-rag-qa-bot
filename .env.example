APP_NAME=Enterprise RAG
APP_VERSION=0.1.0
APP_ENV=development

# ===== Embedding（向量化）=====
EMBEDDING_PROVIDER=aliyun
ALIYUN_API_KEY=your-aliyun-api-key
ALIYUN_EMBEDDING_MODEL=qwen3.7-text-embedding
# 向量化并发度：大文档分多批调用 embedding 接口，并发发送可显著加快入库。
# 默认 5；网络好可调大（如 8），遇到接口限流(429)可调小。
EMBEDDING_CONCURRENCY=5

# ===== 回答生成 =====
ANSWER_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_CHAT_MODEL=deepseek-v4-pro

# ===== 向量库（Chroma）与检索 =====
# CHROMA_DIR：向量库持久化目录（默认 data/chroma）
# CHROMA_COLLECTION：集合名（相当于知识库名，至少 3 个字符）
# RAG_TOP_K：每次提问检索的片段数（默认 5）
# RAG_MAX_DISTANCE：相似度距离阈值（余弦距离，越小越相关；大于此值视为不相关而丢弃，默认 0.5）
# DOCUMENTS_DIR：知识库文档目录（默认 data/documents）
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=knowledge_base
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.5
DOCUMENTS_DIR=data/documents

# ===== MySQL（文档元数据持久化）=====
# 存放文档分类/描述/上传时间/状态等元数据，替换前端 localStorage。
# 库无需手动建表：后端启动会自动建 documents 表；库本身需先存在（utf8mb4）。
# MYSQL_ENABLED=false 可关闭 MySQL，后端自动降级为内存元数据（仅不落盘，主流程不受影响）。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=enterprise_rag
MYSQL_ENABLED=true

# ===== 认证（JWT）=====
# JWT_SECRET：登录令牌签名密钥，生产环境务必改成随机长字符串。
# JWT_EXPIRE_MINUTES：令牌有效期（分钟），默认 720=12 小时。
# DEFAULT_ADMIN_*：首次启动、用户表为空时自动创建的管理员账号。
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRE_MINUTES=720
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
